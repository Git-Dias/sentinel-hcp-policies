					},
					"module": {
						"outputs": {
							"db_subnet_ids": {
								"description": "IDs das subnets de banco de dados",
								"expression": {
									"references": [
										"aws_subnet.db",
									],
								},
							},
							"public_subnet_ids": {
								"description": "IDs das subnets públicas",
								"expression": {
									"references": [
										"aws_subnet.public",
