										"constant_value": true,
									},
									"tags": {
										"references": [
											"each.value",
										],
									},
									"vpc_id": {
										"references": [
											"aws_vpc.this.id",
											"aws_vpc.this",
										],
									},
								},
								"for_each_expression": {
									"references": [
										"var.public_subnet_cidrs",
									],
								},
								"mode":                "managed",
								"name":                "public",
								"provider_config_key": "aws",
								"schema_version":      1,
								"type":                "aws_subnet",
							},
							{
								"address": "aws_vpc.this",
								"expressions": {
									"cidr_block": {
										"references": [
											"var.vpc_cidr_block",
										],
									},
									"enable_dns_hostnames": {
										"constant_value": true,
									},
									"enable_dns_support": {
										"constant_value": true,
									},
									"tags": {
										"constant_value": {
											"Name": "lab-vpc",
										},
									},
								},
								"mode":                "managed",
								"name":                "this",
								"provider_config_key": "aws",
								"schema_version":      1,
								"type":                "aws_vpc",
							},
						],
						"variables": {
							"db_subnet_cidrs": {
								"description": "Lista de CIDRs para subnets de banco de dados",
							},
							"public_subnet_cidrs": {
								"description": "Lista de CIDRs para subnets públicas",
							},
							"vpc_cidr_block": {
								"description": "CIDR da VPC",
							},
						},
					},
					"source": "./modules/network",
				},
				"rds": {
					"count_expression": {
						"references": [
							"var.enable_rds",
						],
					},
					"expressions": {
						"allocated_storage": {
							"constant_value": 20,
						},
						"engine": {
							"constant_value": "postgres",
						},
						"engine_version": {
							"constant_value": "14.11",
						},
						"instance_class": {
							"constant_value": "db.t3.micro",
						},
						"password": {
							"constant_value": "TroqueEstaSenha123!",
						},
						"subnet_ids": {
							"references": [
								"module.network",
							],
						},
						"username": {
							"constant_value": "adminuser",
						},
						"vpc_id": {
							"references": [
								"module.network",
							],
						},
					},
					"module": {
						"outputs": {
