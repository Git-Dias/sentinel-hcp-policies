										],
									},
									"db_name": {
										"constant_value": "labdb",
									},
									"db_subnet_group_name": {
										"references": [
											"aws_db_subnet_group.this.name",
											"aws_db_subnet_group.this",
										],
									},
									"engine": {
										"references": [
											"var.engine",
										],
									},
									"engine_version": {
										"references": [
											"var.engine_version",
										],
									},
									"instance_class": {
										"references": [
											"var.instance_class",
										],
									},
									"password": {
										"references": [
											"var.password",
										],
									},
									"publicly_accessible": {
										"constant_value": false,
									},
									"skip_final_snapshot": {
										"constant_value": true,
									},
									"storage_encrypted": {
										"constant_value": true,
									},
									"tags": {
										"constant_value": {
											"Name": "lab-rds",
										},
									},
									"username": {
										"references": [
											"var.username",
										],
									},
								},
								"mode":                "managed",
								"name":                "this",
								"provider_config_key": "aws",
								"schema_version":      1,
								"type":                "aws_db_instance",
							},
							{
								"address": "aws_db_subnet_group.this",
								"expressions": {
									"name": {
										"constant_value": "lab-rds-subnet-group",
									},
									"subnet_ids": {
										"references": [
											"var.subnet_ids",
										],
									},
									"tags": {
										"constant_value": {
											"Name": "lab-rds-subnet-group",
										},
									},
								},
								"mode":                "managed",
								"name":                "this",
								"provider_config_key": "aws",
								"schema_version":      0,
								"type":                "aws_db_subnet_group",
							},
						],
						"variables": {
							"allocated_storage": {
								"description": "Armazenamento alocado em GB",
							},
							"engine": {
								"description": "Engine do banco (ex: postgres, mysql)",
							},
							"engine_version": {
								"description": "Versão da engine",
							},
							"instance_class": {
								"description": "Classe da instância RDS",
							},
							"password": {
								"description": "Senha do usuário master",
								"sensitive":   true,
							},
							"subnet_ids": {
								"description": "Lista de subnets para o DB subnet group",
							},
							"username": {
								"description": "Usuário master do banco",
							},
							"vpc_id": {
								"description": "ID da VPC onde o RDS será criado",
							},
						},
					},
					"source": "./modules/rds",
				},
				"s3": {
					"count_expression": {
						"references": [
							"var.enable_s3",
						],
					},
					"expressions": {
						"bucket_name_prefix": {
							"constant_value": "lab-modular",
						},
					},
					"module": {
						"outputs": {
							"bucket_name": {
								"description": "Nome do bucket S3 criado",
								"expression": {
									"references": [
										"aws_s3_bucket.this.bucket",
										"aws_s3_bucket.this",
									],
								},
							},
						},
						"resources": [
							{
								"address": "aws_s3_bucket.this",
								"expressions": {
									"bucket": {
										"references": [
											"local.bucket_name",
										],
									},
									"tags": {
										"constant_value": {
											"Name": "lab-s3",
										},
									},
								},
								"mode":                "managed",
								"name":                "this",
								"provider_config_key": "aws",
								"schema_version":      0,
								"type":                "aws_s3_bucket",
							},
							{
								"address": "aws_s3_bucket_versioning.this",
								"expressions": {
									"bucket": {
										"references": [
											"aws_s3_bucket.this.id",
											"aws_s3_bucket.this",
										],
									},
									"versioning_configuration": [
										{
											"status": {
												"references": [
													"var.versioning_enabled",
												],
											},
										},
									],
								},
								"mode":                "managed",
								"name":                "this",
								"provider_config_key": "aws",
								"schema_version":      0,
								"type":                "aws_s3_bucket_versioning",
							},
							{
								"address": "random_id.suffix",
								"expressions": {
									"byte_length": {
										"constant_value": 4,
									},
								},
								"mode":                "managed",
								"name":                "suffix",
								"provider_config_key": "random",
								"schema_version":      0,
								"type":                "random_id",
							},
						],
						"variables": {
							"bucket_name_prefix": {
								"description": "Prefixo para o nome do bucket S3",
							},
							"mfa_delete_enabled": {
								"default": false,
							},
							"versioning_enabled": {
								"default":     true,
								"description": "Habilita versionamento no bucket",
							},
						},
					},
					"source": "./modules/s3",
				},
			},
			"variables": {
				"aws_region": {
					"default":     "us-east-1",
					"description": "Região AWS usada no laboratório",
				},
				"enable_ec2": {
					"default":     false,
					"description": "Habilita a criação de instâncias EC2",
				},
				"enable_network": {
					"default":     true,
					"description": "Habilita a criação de VPC e subnets",
				},
				"enable_rds": {
					"default":     true,
					"description": "Habilita a criação de instância RDS",
				},
				"enable_s3": {
					"default":     false,
					"description": "Habilita a criação de buckets S3",
				},
			},
		},
	},
	"format_version": "1.2",
	"planned_values": {
		"root_module": {
			"child_modules": [
				{
					"address": "module.network[0]",
