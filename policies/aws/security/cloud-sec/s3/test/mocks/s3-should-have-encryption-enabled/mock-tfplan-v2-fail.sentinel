									],
								},
								"mode":                "managed",
								"name":                "db",
								"provider_config_key": "aws",
								"schema_version":      1,
								"type":                "aws_subnet",
							},
							{
								"address": "aws_subnet.public",
								"expressions": {
									"cidr_block": {
										"references": [
											"each.value",
										],
									},
									"map_public_ip_on_launch": {
										"references": [
											"var.public_subnet_auto_public_ip",
										],
									},
									"tags": {
