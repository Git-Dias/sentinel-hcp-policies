raw = {
	"configuration": {
		"provider_config": {
			"aws": {
				"expressions": {
					"region": {
						"references": [
							"var.aws_region",
						],
					},
				},
				"full_name":          "registry.terraform.io/hashicorp/aws",
				"name":               "aws",
				"version_constraint": "4.52.0",
			},
			"random": {
				"full_name":          "registry.terraform.io/hashicorp/random",
				"name":               "random",
				"version_constraint": "3.4.3",
			},
		},
		"root_module": {
			"module_calls": {
				"ec2": {
					"count_expression": {
						"references": [
							"var.enable_ec2",
						],
					},
					"expressions": {
						"instance_count": {
							"constant_value": 1,
						},
						"instance_type": {
							"constant_value": "t3.micro",
						},
						"subnet_id": {
							"references": [
								"module.network",
							],
						},
						"vpc_id": {
							"references": [
								"module.network",
							],
						},
					},
					"module": {
						"outputs": {
							"instance_ids": {
								"description": "IDs das instâncias EC2 criadas",
								"expression": {
									"references": [
										"aws_instance.this",
									],
								},
							},
							"public_ips": {
								"description": "IPs públicos das instâncias (se houver)",
								"expression": {
									"references": [
										"aws_instance.this",
									],
								},
							},
						},
						"resources": [
							{
								"address": "aws_ebs_volume.example",
								"expressions": {
									"availability_zone": {
										"constant_value": "us-east-1a",
									},
									"encrypted": {
										"constant_value": false,
									},
									"size": {
										"constant_value": 8,
									},
								},
								"mode":                "managed",
								"name":                "example",
								"provider_config_key": "aws",
								"schema_version":      0,
								"type":                "aws_ebs_volume",
							},
							{
								"address": "aws_instance.this",
								"count_expression": {
									"references": [
										"var.instance_count",
									],
								},
								"expressions": {
									"ami": {
										"references": [
											"data.aws_ami.ubuntu.id",
											"data.aws_ami.ubuntu",
										],
									},
									"instance_type": {
										"references": [
											"var.instance_type",
										],
									},
									"subnet_id": {
										"references": [
											"var.subnet_id",
										],
									},
									"tags": {
										"references": [
											"count.index",
										],
									},
								},
								"mode":                "managed",
								"name":                "this",
								"provider_config_key": "aws",
								"schema_version":      1,
								"type":                "aws_instance",
							},
							{
								"address": "data.aws_ami.ubuntu",
								"expressions": {
									"filter": [
										{
											"name": {
												"constant_value": "name",
											},
											"values": {
												"constant_value": [
													"ubuntu/images/hvm-ssd/ubuntu-focal-20.04-amd64-server-*",
												],
											},
										},
										{
											"name": {
												"constant_value": "virtualization-type",
											},
											"values": {
												"constant_value": [
													"hvm",
												],
											},
										},
									],
									"most_recent": {
										"constant_value": true,
									},
									"owners": {
										"constant_value": [
											"099720109477",
										],
									},
								},
								"mode":                "data",
								"name":                "ubuntu",
								"provider_config_key": "aws",
								"schema_version":      0,
								"type":                "aws_ami",
							},
						],
						"variables": {
							"instance_count": {
								"default":     1,
								"description": "Quantidade de instâncias EC2",
							},
							"instance_type": {
								"default":     "t3.micro",
								"description": "Tipo das instâncias EC2",
							},
							"subnet_id": {
								"description": "Subnet onde as instâncias serão criadas",
							},
							"vpc_id": {
								"description": "ID da VPC onde as instâncias serão criadas",
							},
						},
					},
					"source": "./modules/ec2",
				},
				"network": {
					"count_expression": {
						"references": [
							"var.enable_network",
						],
					},
					"expressions": {
						"db_subnet_cidrs": {
							"constant_value": [
								"10.0.2.0/24",
							],
						},
						"public_subnet_cidrs": {
							"constant_value": [
								"10.0.1.0/24",
							],
						},
						"vpc_cidr_block": {
							"constant_value": "10.0.0.0/16",
						},
					},
					"module": {
						"outputs": {
							"db_subnet_ids": {
								"description": "IDs das subnets de banco de dados",
								"expression": {
									"references": [
										"aws_subnet.db",
									],
								},
							},
							"public_subnet_ids": {
								"description": "IDs das subnets públicas",
								"expression": {
									"references": [
										"aws_subnet.public",
									],
								},
							},
							"vpc_id": {
								"description": "ID da VPC criada",
								"expression": {
									"references": [
										"aws_vpc.this.id",
										"aws_vpc.this",
									],
								},
							},
						},
						"resources": [
							{
								"address": "aws_subnet.db",
								"expressions": {
									"cidr_block": {
										"references": [
											"each.value",
										],
									},
									"tags": {
										"references": [
											"each.value",
										],
									},
									"vpc_id": {
										"references": [
											"aws_vpc.this.id",
											"aws_vpc.this",
										],
									},
								},
								"for_each_expression": {
									"references": [
										"var.db_subnet_cidrs",
									],
								},
								"mode":                "managed",
								"name":                "db",
								"provider_config_key": "aws",
								"schema_version":      1,
								"type":                "aws_subnet",
							},
							{
								"address": "aws_subnet.public",
								"expressions": {
									"cidr_block": {
										"references": [
											"each.value",
										],
									},
									"map_public_ip_on_launch": {
										"constant_value": true,
									},
									"tags": {
										"references": [
											"each.value",
										],
									},
									"vpc_id": {
										"references": [
											"aws_vpc.this.id",
											"aws_vpc.this",
										],
									},
								},
								"for_each_expression": {
									"references": [
										"var.public_subnet_cidrs",
									],
								},
								"mode":                "managed",
								"name":                "public",
								"provider_config_key": "aws",
								"schema_version":      1,
								"type":                "aws_subnet",
							},
							{
								"address": "aws_vpc.this",
								"expressions": {
									"cidr_block": {
										"references": [
											"var.vpc_cidr_block",
										],
									},
									"enable_dns_hostnames": {
										"constant_value": true,
									},
									"enable_dns_support": {
										"constant_value": true,
									},
									"tags": {
										"constant_value": {
											"Name": "lab-vpc",
										},
									},
								},
								"mode":                "managed",
								"name":                "this",
								"provider_config_key": "aws",
								"schema_version":      1,
								"type":                "aws_vpc",
							},
						],
						"variables": {
							"db_subnet_cidrs": {
								"description": "Lista de CIDRs para subnets de banco de dados",
							},
							"public_subnet_cidrs": {
								"description": "Lista de CIDRs para subnets públicas",
							},
							"vpc_cidr_block": {
								"description": "CIDR da VPC",
							},
						},
					},
					"source": "./modules/network",
				},
