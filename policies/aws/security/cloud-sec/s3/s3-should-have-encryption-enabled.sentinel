# S3 buckets should have encryption enabled

# Imports
import "tfplan/v2" as tfplan

# Get all S3 bucket acls
allS3BucketsServerSideEnc = tfplan.find_resources("aws_s3_bucket_server_side_encryption_configuration")

# Filter to S3 buckets that are not encrypted by KMS
# Warnings will be printed for all violations since the last parameter is true

nonKMSEncryptedS3Buckets = tfplan.filter_attribute_is_not_value(allS3BucketsServerSideEnc,
	"rule.0.apply_server_side_encryption_by_default.0.sse_algorithm",
	"aws:kms", false)

nonAESEncryptedS3Buckets = tfplan.filter_attribute_is_not_value(allS3BucketsServerSideEnc,
	"rule.0.apply_server_side_encryption_by_default.0.sse_algorithm",
	"AES256", false)

# Main rule
validated = length(nonKMSEncryptedS3Buckets["messages"]) is 0 or length(nonAESEncryptedS3Buckets["messages"]) is 0
main = rule {
	validated is true
}

if not main {
	print("X S3 - VIOLAÇÃO DETECTADA")
	print("   Buckets S3 devem ter criptografia habilitada")
	print("   Consulte o baseline de Segurança para mais informações")
	print(" ")
}