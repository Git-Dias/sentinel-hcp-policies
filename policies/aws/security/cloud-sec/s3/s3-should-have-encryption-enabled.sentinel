# S3 buckets must have server-side encryption enabled

import "tfplan/v2" as tfplan

allowed_algorithms = ["AES256", "aws:kms"]

#
# Buckets criados ou alterados
#
s3_buckets = filter tfplan.resource_changes as _, rc {
  rc.type is "aws_s3_bucket" and
  (rc.change.actions contains "create" or rc.change.actions contains "update")
}

#
# Encryption configs criadas ou alteradas
#
s3_encryptions = filter tfplan.resource_changes as _, rc {
  rc.type is "aws_s3_bucket_server_side_encryption_configuration" and
  (rc.change.actions contains "create" or rc.change.actions contains "update")
}

#
# Buckets sem encryption associada
#
buckets_without_encryption = filter s3_buckets as _, bucket {
  length(filter s3_encryptions as _, enc {
    enc.change.after.bucket is bucket.change.after.bucket
  }) is 0
}

#
# Encryption inválida (null-safe e sem atribuição)
#
invalid_encryption = filter s3_encryptions as _, enc {

  enc.change.after.rule is not defined or
  length(enc.change.after.rule) is 0 or
  enc.change.after.rule[0].apply_server_side_encryption_by_default is not defined or
  length(enc.change.after.rule[0].apply_server_side_encryption_by_default) is 0 or
  not (
    enc.change.after.rule[0].apply_server_side_encryption_by_default[0].sse_algorithm
    in allowed_algorithms
  )
}

#
# Regra principal
#
main = rule {
  length(buckets_without_encryption) is 0 and
  length(invalid_encryption) is 0
}

#
# Output
#
if not main {
  print("X S3 - VIOLAÇÃO DETECTADA")
  print("Todos os buckets devem possuir encryption configurada.")
  print("Algoritmos permitidos: AES256 ou aws:kms.")
}