# S3 buckets should have encryption enabled

import "tfplan/v2" as tfplan

# Get all S3 encryption configuration resources being created or updated
s3_encryption = filter tfplan.resource_changes as _, rc {
  rc.type is "aws_s3_bucket_server_side_encryption_configuration" and
  (rc.change.actions contains "create" or rc.change.actions contains "update")
}

# Buckets that do NOT use KMS
non_kms = filter s3_encryption as _, r {
  r.change.after.rule[0].apply_server_side_encryption_by_default[0].sse_algorithm is not "aws:kms"
}

# Buckets that do NOT use AES256
non_aes = filter s3_encryption as _, r {
  r.change.after.rule[0].apply_server_side_encryption_by_default[0].sse_algorithm is not "AES256"
}

validated = length(non_kms) is 0 or length(non_aes) is 0

main = rule {
  validated
}

if not main {
  print("X S3 - VIOLAÇÃO DETECTADA")
  print("Buckets S3 devem ter criptografia habilitada")
}