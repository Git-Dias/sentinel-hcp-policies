# S3 buckets must have encryption enabled (AES256 or aws:kms)

import "tfplan/v2" as tfplan

###############################################################################
# Constantes
###############################################################################

allowed_algorithms = ["AES256", "aws:kms"]

###############################################################################
# Helper: verifica se o resource_change possui ação relevante
###############################################################################

is_relevant_action = func(rc) {
  return rc.change.actions contains "create" or
         rc.change.actions contains "update" or
         rc.change.actions contains "no-op"
}

###############################################################################
# Fontes de dados — filtragem nativa via resource_changes
###############################################################################

s3_buckets = filter tfplan.resource_changes as _, rc {
  rc.type is "aws_s3_bucket" and
  rc.mode is "managed" and
  is_relevant_action(rc)
}

s3_encryptions = filter tfplan.resource_changes as _, rc {
  rc.type is "aws_s3_bucket_server_side_encryption_configuration" and
  rc.mode is "managed" and
  is_relevant_action(rc)
}

###############################################################################
# Helper: valida se um bucket possui encryption configurada corretamente
###############################################################################

has_valid_encryption = func(bucket) {
  bucket_name = bucket.change.after.bucket else "<unknown>"

  matching = filter s3_encryptions as _, enc {
    enc.change.after.bucket is bucket.change.after.bucket
  }

  if length(matching) is 0 {
    print("VIOLATION [S3-ENCRYPTION] Bucket '" + bucket_name + "' não possui aws_s3_bucket_server_side_encryption_configuration associada.")
    return false
  }

  enc   = values(matching)[0]
  rules = enc.change.after.rule else []

  if length(rules) is 0 {
    print("VIOLATION [S3-ENCRYPTION] Bucket '" + bucket_name + "' possui encryption configuration sem bloco 'rule' definido.")
    return false
  }

  defaults = rules[0].apply_server_side_encryption_by_default else []

  if length(defaults) is 0 {
    print("VIOLATION [S3-ENCRYPTION] Bucket '" + bucket_name + "' não possui 'apply_server_side_encryption_by_default' configurado.")
    return false
  }

  algo = defaults[0].sse_algorithm else ""

  if algo not in allowed_algorithms {
    print("VIOLATION [S3-ENCRYPTION] Bucket '" + bucket_name + "' utiliza algoritmo inválido: '" + algo + "'. Permitidos: " + string(allowed_algorithms))
    return false
  }

  return true
}

###############################################################################
# Regra principal
###############################################################################

main = rule {
  all s3_buckets as _, bucket {
    has_valid_encryption(bucket)
  }
}