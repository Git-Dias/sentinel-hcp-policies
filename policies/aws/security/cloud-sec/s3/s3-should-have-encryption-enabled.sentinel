# S3 buckets must have encryption enabled (AES256 or aws:kms)

import "tfplan/v2" as tfplan

allowed_algorithms = ["AES256", "aws:kms"]

#
# Busca todos os buckets planejados
#
s3_buckets = tfplan.find_resources("aws_s3_bucket")

#
# Busca todas as configurações de encryption
#
s3_encryptions = tfplan.find_resources("aws_s3_bucket_server_side_encryption_configuration")

#
# Bucket sem encryption
#
buckets_without_encryption = filter s3_buckets as _, bucket {
  length(filter s3_encryptions as _, enc {
    enc.applied.bucket is bucket.applied.bucket
  }) is 0
}

#
# Encryption inválida
#
invalid_encryption = filter s3_encryptions as _, enc {
  enc.applied.rule is not defined or
  length(enc.applied.rule) is 0 or
  enc.applied.rule[0].apply_server_side_encryption_by_default is not defined or
  length(enc.applied.rule[0].apply_server_side_encryption_by_default) is 0 or
  enc.applied.rule[0].apply_server_side_encryption_by_default[0].sse_algorithm is not "AES256" and
  enc.applied.rule[0].apply_server_side_encryption_by_default[0].sse_algorithm is not "aws:kms"
}

#
# Regra principal
#
main = rule {
  length(buckets_without_encryption) is 0 and
  length(invalid_encryption) is 0
}

#
# Output
#
if not main {
  print("X S3 - VIOLAÇÃO DETECTADA")
  print("Todos os buckets devem possuir encryption configurada.")
  print("Algoritmos permitidos: AES256 ou aws:kms.")
}