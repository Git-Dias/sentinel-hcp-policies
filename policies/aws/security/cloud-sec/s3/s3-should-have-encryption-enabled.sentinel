# S3 buckets must have encryption enabled with AES256 or aws:kms

import "tfplan/v2" as tfplan

# Buckets sendo criados ou atualizados
s3_buckets = filter tfplan.resource_changes as _, rc {
  rc.type is "aws_s3_bucket" and
  (rc.change.actions contains "create" or rc.change.actions contains "update")
}

# Encryption configs sendo criadas ou atualizadas
s3_encryption = filter tfplan.resource_changes as _, rc {
  rc.type is "aws_s3_bucket_server_side_encryption_configuration" and
  (rc.change.actions contains "create" or rc.change.actions contains "update")
}

# Buckets sem encryption
buckets_without_encryption = filter s3_buckets as _, bucket {
  length(filter s3_encryption as _, enc {
    enc.change.after.bucket is bucket.change.after.bucket
  }) is 0
}

# Encryption inválida
invalid_encryption = filter s3_encryption as _, enc {
  enc.change.after.rule[0].apply_server_side_encryption_by_default[0].sse_algorithm is not "AES256" and
  enc.change.after.rule[0].apply_server_side_encryption_by_default[0].sse_algorithm is not "aws:kms"
}

main = rule {
  length(buckets_without_encryption) is 0 and
  length(invalid_encryption) is 0
}

if not main {
  print("X S3 - VIOLAÇÃO DETECTADA")
  print("Todos os buckets devem possuir encryption configurada")
  print("Algoritmo permitido: AES256 ou aws:kms")
}