# Volumes EBS devem ter a criptografia habilitada

# Import
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "collection" as collection
import "collection/maps" as maps

# Constants
const = {
	"policy_name": "ec2-ebs-encryption-enabled",
	"message":     "Volumes EBS devem ter a criptografia habilitada",
	"encrypted":   "encrypted",
}

# Variables
resources = tf.plan(tfplan.planned_values.resources).type("aws_ebs_volume").resources
violations = collection.reject(resources, func(res) {
	encrypted_key = maps.get(res, "values.encrypted", false)
	return encrypted_key is true
})

# Regra Principal
main = rule {
	violations is empty
}

# Print detalhado dos resultados
if not main {
	print("X EC2 - VIOLAÇÃO DETECTADA")
	print("   Todos os volumes EBS devem ter a criptografia em repouso habilitada")
	print("   Consulte o baseline de Segurança para mais informações")
	print("   const.message")
}