				"full_name":          "registry.terraform.io/hashicorp/aws",
				"name":               "aws",
				"version_constraint": "4.52.0",
			},
			"random": {
				"full_name":          "registry.terraform.io/hashicorp/random",
				"name":               "random",
				"version_constraint": "3.4.3",
			},
		},
		"root_module": {
			"module_calls": {
				"ec2": {
					"count_expression": {
						"references": [
							"var.enable_ec2",
						],
					},
					"expressions": {
						"instance_count": {
							"constant_value": 1,
						},
						"instance_type": {
							"constant_value": "t3.micro",
						},
						"subnet_id": {
							"references": [
								"module.network",
							],
						},
						"vpc_id": {
							"references": [
								"module.network",
							],
						},
					},
					"module": {
						"outputs": {
							"instance_ids": {
								"description": "IDs das instâncias EC2 criadas",
								"expression": {
									"references": [
										"aws_instance.this",
									],
								},
							},
							"public_ips": {
								"description": "IPs públicos das instâncias (se houver)",
								"expression": {
									"references": [
										"aws_instance.this",
									],
								},
							},
						},
						"resources": [
							{
								"address": "aws_ebs_volume.example",
								"expressions": {
									"availability_zone": {
										"constant_value": "us-east-1a",
									},
									"encrypted": {
										"constant_value": true,
									},
									"size": {
										"constant_value": 8,
									},
								},
								"mode":                "managed",
								"name":                "example",
								"provider_config_key": "aws",
								"schema_version":      0,
								"type":                "aws_ebs_volume",
							},
							{
								"address": "aws_instance.this",
								"count_expression": {
									"references": [
										"var.instance_count",
									],
								},
								"expressions": {
									"ami": {
										"references": [
											"data.aws_ami.ubuntu.id",
											"data.aws_ami.ubuntu",
										],
									},
									"associate_public_ip_address": {
										"references": [
											"var.enable_public_ip",
										],
									},
									"instance_type": {
										"references": [
											"var.instance_type",
										],
									},
									"metadata_options": [
										{
											"http_endpoint": {
												"constant_value": "enabled",
											},
											"http_put_response_hop_limit": {
												"constant_value": 1,
											},
											"http_tokens": {
												"constant_value": "required",
											},
										},
									],
									"subnet_id": {
										"references": [
											"var.subnet_id",
										],
									},
									"tags": {
										"references": [
											"count.index",
										],
									},
								},
								"mode":                "managed",
								"name":                "this",
								"provider_config_key": "aws",
								"schema_version":      1,
								"type":                "aws_instance",
							},
							{
								"address": "data.aws_ami.ubuntu",
								"expressions": {
									"filter": [
										{
											"name": {
												"constant_value": "name",
											},
											"values": {
												"constant_value": [
													"ubuntu/images/hvm-ssd/ubuntu-focal-20.04-amd64-server-*",
												],
											},
										},
										{
											"name": {
												"constant_value": "virtualization-type",
											},
											"values": {
												"constant_value": [
													"hvm",
												],
											},
										},
									],
									"most_recent": {
										"constant_value": true,
									},
									"owners": {
										"constant_value": [
											"099720109477",
										],
									},
								},
								"mode":                "data",
								"name":                "ubuntu",
								"provider_config_key": "aws",
								"schema_version":      0,
								"type":                "aws_ami",
							},
						],
						"variables": {
							"enable_public_ip": {
								"default":     false,
								"description": "Define se a instância deve ter IP público",
							},
							"instance_count": {
								"default":     1,
								"description": "Quantidade de instâncias EC2",
							},
							"instance_type": {
								"default":     "t3.micro",
								"description": "Tipo das instâncias EC2",
							},
							"subnet_id": {
								"description": "Subnet onde as instâncias serão criadas",
							},
							"vpc_id": {
								"description": "ID da VPC onde as instâncias serão criadas",
							},
						},
					},
					"source": "./modules/ec2",
				},
				"network": {
					"count_expression": {
						"references": [
							"var.enable_network",
						],
					},
					"expressions": {
						"db_subnet_cidrs": {
							"constant_value": [
								"10.0.2.0/24",
							],
						},
						"public_subnet_cidrs": {
							"constant_value": [
								"10.0.1.0/24",
							],
						},
						"vpc_cidr_block": {
							"constant_value": "10.0.0.0/16",
						},
					},
					"module": {
						"outputs": {
							"db_subnet_ids": {
								"description": "IDs das subnets de banco de dados",
								"expression": {
									"references": [
										"aws_subnet.db",
									],
								},
							},
							"public_subnet_ids": {
								"description": "IDs das subnets públicas",
								"expression": {
									"references": [
										"aws_subnet.public",
									],
								},
							},
							"vpc_id": {
								"description": "ID da VPC criada",
								"expression": {
									"references": [
										"aws_vpc.this.id",
										"aws_vpc.this",
									],
								},
							},
						},
						"resources": [
							{
								"address": "aws_subnet.db",
								"expressions": {
									"cidr_block": {
										"references": [
											"each.value",
										],
									},
									"tags": {
										"references": [
											"each.value",
										],
									},
									"vpc_id": {
										"references": [
											"aws_vpc.this.id",
											"aws_vpc.this",
										],
									},
								},
								"for_each_expression": {
									"references": [
										"var.db_subnet_cidrs",
									],
								},
								"mode":                "managed",
								"name":                "db",
								"provider_config_key": "aws",
								"schema_version":      1,
								"type":                "aws_subnet",
							},
							{
								"address": "aws_subnet.public",
								"expressions": {
									"cidr_block": {
										"references": [
											"each.value",
										],
									},
									"map_public_ip_on_launch": {
										"references": [
											"var.public_subnet_auto_public_ip",
										],
									},
									"tags": {
										"references": [
											"each.value",
										],
									},
									"vpc_id": {
										"references": [
											"aws_vpc.this.id",
											"aws_vpc.this",
										],
									},
								},
								"for_each_expression": {
									"references": [
										"var.public_subnet_cidrs",
									],
								},
								"mode":                "managed",
								"name":                "public",
								"provider_config_key": "aws",
								"schema_version":      1,
								"type":                "aws_subnet",
							},
							{
								"address": "aws_vpc.this",
								"expressions": {
									"cidr_block": {
										"references": [
											"var.vpc_cidr_block",
										],
									},
									"enable_dns_hostnames": {
										"constant_value": true,
									},
									"enable_dns_support": {
										"constant_value": true,
									},
									"tags": {
										"constant_value": {
											"Name": "lab-vpc",
										},
									},
								},
								"mode":                "managed",
								"name":                "this",
								"provider_config_key": "aws",
								"schema_version":      1,
								"type":                "aws_vpc",
							},
						],
						"variables": {
							"db_subnet_cidrs": {
								"description": "Lista de CIDRs para subnets de banco de dados",
							},
							"public_subnet_auto_public_ip": {
								"default": false,
							},
							"public_subnet_cidrs": {
								"description": "Lista de CIDRs para subnets públicas",
							},
							"vpc_cidr_block": {
								"description": "CIDR da VPC",
							},
						},
					},
					"source": "./modules/network",
				},
				"rds": {
					"count_expression": {
						"references": [
							"var.enable_rds",
						],
					},
					"expressions": {
						"allocated_storage": {
							"constant_value": 20,
						},
						"engine": {
							"constant_value": "postgres",
						},
						"engine_version": {
							"constant_value": "14.11",
						},
						"instance_class": {
							"constant_value": "db.t3.micro",
						},
						"password": {
							"constant_value": "TroqueEstaSenha123!",
						},
						"subnet_ids": {
							"references": [
								"module.network",
							],
						},
						"username": {
							"constant_value": "adminuser",
						},
						"vpc_id": {
							"references": [
								"module.network",
							],
						},
					},
					"module": {
						"outputs": {
							"endpoint": {
								"description": "Endpoint do banco RDS",
								"expression": {
									"references": [
										"aws_db_instance.this.address",
										"aws_db_instance.this",
									],
								},
							},
							"port": {
								"description": "Porta do RDS",
								"expression": {
									"references": [
										"aws_db_instance.this.port",
										"aws_db_instance.this",
									],
								},
							},
						},
						"resources": [
							{
								"address": "aws_db_instance.this",
								"expressions": {
									"allocated_storage": {
										"references": [
											"var.allocated_storage",
										],
									},
									"db_name": {
										"constant_value": "labdb",
									},
									"db_subnet_group_name": {
										"references": [
											"aws_db_subnet_group.this.name",
											"aws_db_subnet_group.this",
										],
									},
									"engine": {
										"references": [
											"var.engine",
										],
									},
									"engine_version": {
										"references": [
											"var.engine_version",
										],
									},
									"instance_class": {
										"references": [
											"var.instance_class",
										],
									},
									"password": {
										"references": [
											"var.password",
										],
									},
									"publicly_accessible": {
										"constant_value": false,
									},
									"skip_final_snapshot": {
										"constant_value": true,
									},
									"storage_encrypted": {
										"constant_value": true,
									},
									"tags": {
										"constant_value": {
											"Name": "lab-rds",
										},
									},
									"username": {
										"references": [
											"var.username",
										],
									},
								},
								"mode":                "managed",
								"name":                "this",
								"provider_config_key": "aws",
								"schema_version":      1,
								"type":                "aws_db_instance",
							},
							{
								"address": "aws_db_subnet_group.this",
								"expressions": {
									"name": {
										"constant_value": "lab-rds-subnet-group",
									},
									"subnet_ids": {
										"references": [
											"var.subnet_ids",
										],
									},
									"tags": {
										"constant_value": {
											"Name": "lab-rds-subnet-group",
										},
									},
								},
								"mode":                "managed",
								"name":                "this",
								"provider_config_key": "aws",
								"schema_version":      0,
								"type":                "aws_db_subnet_group",
							},
						],
						"variables": {
							"allocated_storage": {
								"description": "Armazenamento alocado em GB",
							},
							"engine": {
								"description": "Engine do banco (ex: postgres, mysql)",
							},
							"engine_version": {
								"description": "Versão da engine",
							},
							"instance_class": {
								"description": "Classe da instância RDS",
							},
							"password": {
								"description": "Senha do usuário master",
								"sensitive":   true,
							},
							"subnet_ids": {
								"description": "Lista de subnets para o DB subnet group",
							},
							"username": {
								"description": "Usuário master do banco",
							},
							"vpc_id": {
								"description": "ID da VPC onde o RDS será criado",
							},
						},
					},
					"source": "./modules/rds",
				},
				"s3": {
					"count_expression": {
						"references": [
							"var.enable_s3",
						],
					},
					"expressions": {
						"bucket_name_prefix": {
							"constant_value": "lab-modular",
						},
					},
					"module": {
						"outputs": {
							"bucket_name": {
								"description": "Nome do bucket S3 criado",
								"expression": {
									"references": [
										"aws_s3_bucket.this.bucket",
										"aws_s3_bucket.this",
									],
								},
							},
						},
						"resources": [
							{
								"address": "aws_s3_bucket.this",
								"expressions": {
									"bucket": {
										"references": [
											"local.bucket_name",
										],
									},
									"tags": {
										"constant_value": {
											"Name": "lab-s3",
										},
									},
								},
								"mode":                "managed",
								"name":                "this",
								"provider_config_key": "aws",
								"schema_version":      0,
								"type":                "aws_s3_bucket",
							},
							{
								"address": "aws_s3_bucket_versioning.this",
								"expressions": {
									"bucket": {
										"references": [
											"aws_s3_bucket.this.id",
											"aws_s3_bucket.this",
										],
									},
									"versioning_configuration": [
										{
											"status": {
												"references": [
													"var.versioning_enabled",
												],
											},
										},
									],
								},
								"mode":                "managed",
								"name":                "this",
								"provider_config_key": "aws",
								"schema_version":      0,
								"type":                "aws_s3_bucket_versioning",
							},
							{
								"address": "random_id.suffix",
								"expressions": {
									"byte_length": {
										"constant_value": 4,
									},
								},
								"mode":                "managed",
								"name":                "suffix",
								"provider_config_key": "random",
								"schema_version":      0,
								"type":                "random_id",
							},
						],
						"variables": {
							"bucket_name_prefix": {
								"description": "Prefixo para o nome do bucket S3",
							},
							"mfa_delete_enabled": {
								"default": false,
							},
							"versioning_enabled": {
								"default":     true,
								"description": "Habilita versionamento no bucket",
							},
						},
					},
					"source": "./modules/s3",
				},
			},
			"variables": {
				"aws_region": {
					"default":     "us-east-1",
					"description": "Região AWS usada no laboratório",
				},
				"enable_ec2": {
					"default":     true,
					"description": "Habilita a criação de instâncias EC2",
				},
				"enable_network": {
					"default":     true,
					"description": "Habilita a criação de VPC e subnets",
				},
				"enable_rds": {
					"default":     false,
					"description": "Habilita a criação de instância RDS",
				},
				"enable_s3": {
					"default":     true,
					"description": "Habilita a criação de buckets S3",
				},
			},
		},
	},
